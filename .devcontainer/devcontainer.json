{
  // Python 3.11 + Java 21 (for the Spark parity test) + uv. Health data is git-ignored and is
  // never copied into the image: mount or copy your export into the workspace yourself.
  "name": "py-apple-health-data-pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "jdkDistro": "tem" },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "postCreateCommand": "make setup && .venv/bin/pre-commit install",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "Streamlit app", "onAutoForward": "openBrowser" } },
  "containerEnv": { "UV_LINK_MODE": "copy" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "redhat.vscode-yaml", "databricks.databricks"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
